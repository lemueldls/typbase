{
  "name": "@typbase/storage",
  "version": "0.4.8",
  "description": "Local-first storage for Typbase: OPFS, picked-folder, Tauri, and memory backends plus the Loro doc registry.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemueldls/typbase"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "build-dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@typbase/typing": "workspace:*",
    "loro-crdt": "^1.17.1"
  },
  "devDependencies": {
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}
