{
  "name": "@typbase/cli",
  "version": "0.4.8",
  "description": "Verify and publish Typbase themes and plugins.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemueldls/typbase"
  },
  "bin": {
