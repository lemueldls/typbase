  "devDependencies": {
    "@typbase/plugin-sdk": "workspace:*",
    "@typbase/skin": "workspace:*",
    "@typbase/spaces": "workspace:*",
    "@typbase/typing": "workspace:*",
    "@types/node": "^26.6.6",
    "airspace": "github:lemueldls/airspace#26ed6f97f1cd729a41acc4076d209f6e8aa66059",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
