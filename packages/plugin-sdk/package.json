{
  "name": "@typbase/plugin-sdk",
  "version": "0.4.8",
  "description": "Typbase plugin bundle (.tbplugin) format and authoring helpers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemueldls/typbase"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "build-dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@typbase/typing": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}
