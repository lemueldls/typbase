{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typbase.at/schemas/plugin.json",
  "title": "Typbase plugin manifest",
  "type": "object",
  "required": ["id", "name", "version", "api", "entry", "capabilities", "surfaces"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "api": { "const": "typbase.host.v2" },
    "entry": { "type": "string", "pattern": "^[\\w./-]+\\.typ$" },
    "icon": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "pages.read",
          "pages.create",
          "pages.write",
          "daily.write",
          "plugin.data",
          "plugin.ai",
          "site.publish",
          "ui.external"
        ]
      }
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["fields"],
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["string", "number", "boolean", "datetime", "json"] },
                "optional": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["kind", "fn", "title"],
        "properties": {
          "kind": { "enum": ["widget", "pane", "window"] },
          "fn": { "type": "string", "pattern": "^[a-z][\\w-]*$" },
          "title": { "type": "string" },
          "icon": { "type": "string" }
        }
      }
    },
    "hostComponents": {
      "type": "array",
      "items": { "enum": ["canvas"] }
    }
  }
}
