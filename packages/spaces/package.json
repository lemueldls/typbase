{
  "name": "@typbase/spaces",
  "version": "0.4.8",
  "description": "The only module that talks to atproto: browser OAuth, the airspace data model, and Loro sync.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lemueldls/typbase"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plugin-registry": "./src/pluginRegistry.ts",
    "./theme-registry": "./src/themeRegistry.ts"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./src/index.ts",
    "exports": {
      ".": {
        "types": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "./plugin-registry": {
        "types": "./src/pluginRegistry.ts",
        "default": "./dist/pluginRegistry.mjs"
      },
      "./theme-registry": {
        "types": "./src/themeRegistry.ts",
        "default": "./dist/themeRegistry.mjs"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "build-dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atproto-labs/did-resolver": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-client": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-schema": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/lex-space": "0.0.0-spaces-alpha-20261117141222",
    "@atproto/oauth-client-browser": "0.5.14",
    "@atproto/syntax": "0.0.0-spaces-alpha-20261117141222",
    "@typbase/skin": "workspace:*",
    "@typbase/typing": "workspace:*",
    "airspace": "github:lemueldls/airspace#8a5b501ccbfc567f5bc23e0c962bec3aea412b4f"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}
