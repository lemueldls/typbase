{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "version": "0.1.0",
  "productName": "Typbase",
  "identifier": "at.typbase.app",
  "build": {
    "beforeBuildCommand": "pnpm -w run build",
    "beforeDevCommand": "pnpm -w run dev",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../../.output/public"
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0",
    "licenseFile": "../../LICENSE",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["dmg", "nsis", "deb", "rpm", "appimage"],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/licenses/typbase/LICENSE": "../../LICENSE"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "app": {
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      }
    },
    "windows": []
  },
  "plugins": {
    "cli": {
      "description": "Local-first note-taking app leveraging the Typst ecosystem.",
      "args": [
        {
          "name": "disable-wayland",
          "description": "Whether to prefer XWayland when available to avoid Wayland protocol errors seen during startup."
        }
      ],
      "subcommands": {}
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": ["at.typbase.app", "typbase"],
          "appLink": false
        },
        {
          "scheme": ["https"],
          "host": "typbase.at",
          "pathPrefix": ["/auth/confirm"],
          "appLink": true
        }
      ],
      "desktop": {
        "schemes": ["at.typbase.app", "typbase"]
      }
    },
    "updater": {
      "createUpdaterArtifacts": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0REVCRDBBNzBDODcyOUIKUldTYmNzaHdDcjNlRkdSOEF1NFRxeWM3bXdXWVBrV3BRd1RIZWtpRmpFZlE4VTg5ZlFlbGdTcHEK",
      "endpoints": ["https://github.com/lemueldls/typbase/releases/latest/download/latest.json"]
    }
  }
}
