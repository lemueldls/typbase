{
  "lexicon": 1,
  "id": "app.typbase.post",
  "defs": {
    "main": {
      "type": "record",
      "description": "A published note. Written to the author's public repo; the record is the canonical pointer to the rendered artifacts. Unpublishing deletes the record, firehose mirrors may retain copies.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "html", "source", "sourceUri"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 400,
            "description": "Note title."
          },
          "summary": {
            "type": "string",
            "maxLength": 2000,
            "description": "Plain-text summary for listings and feeds."
          },
          "html": {
            "type": "blob",
            "accept": ["text/html"],
            "description": "Rendered HTML of the note."
          },
          "pdf": {
            "type": "blob",
            "accept": ["application/pdf"],
            "description": "Optional rendered PDF."
          },
          "source": {
            "type": "string",
            "description": "The Typst source, for the curious and for re-publishing."
          },
          "sourceUri": {
            "type": "string",
            "description": "Link back into the workspace source (space record URI or app deep link)."
          },
          "langs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 16
            },
            "description": "Language codes."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "description": "Tags for feeds and discovery."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
