{
  "lexicon": 1,
  "id": "app.typbase.asset",
  "defs": {
    "main": {
      "type": "record",
      "description": "Maps a reference path in a page (asset://...) to a blob stored in the space. Written by the member who uploaded the blob.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["docId", "ref", "blob", "mime", "size"],
        "properties": {
          "docId": {
            "type": "string",
            "description": "Page doc id that references the asset."
          },
          "ref": {
            "type": "string",
            "description": "Reference path as used in Typst source, e.g. 'cover.png'."
          },
          "blob": {
            "type": "blob",
            "description": "The media blob."
          },
          "mime": {
            "type": "string",
            "description": "Media mime type."
          },
          "size": {
            "type": "integer",
            "description": "Blob size in bytes."
          },
          "alt": {
            "type": "string",
            "description": "Accessibility text."
          }
        }
      }
    }
  }
}
