{
  "lexicon": 1,
  "id": "app.typbase.config",
  "defs": {
    "main": {
      "type": "record",
      "description": "Workspace metadata held in the space rather than in a Loro doc, so non-Typbase apps can read it without decoding CRDT state.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Workspace name."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Short description shown to members and third-party apps."
          },
          "publicInfo": {
            "type": "unknown",
            "description": "App-defined metadata (e.g. publish defaults). Not enforced beyond JSON validity."
          },
          "icon": {
            "type": "blob",
            "accept": ["image/*"],
            "maxSize": 1000000,
            "description": "Optional workspace icon."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Creation timestamp."
          }
        }
      }
    }
  }
}
