{
  "id": "local:drawing",
  "name": "Drawing",
  "version": "0.4.0",
  "description": "A touch-friendly drawing canvas in a floating window, with undo, an eraser, and a Typst embed for notes.",
  "api": "typbase.host.v2",
  "entry": "main.typ",
  "icon": "draw",
  "capabilities": ["pages.read", "pages.write", "plugin.data"],
  "collections": {
    "strokes": {
      "fields": {
        "color": { "type": "string" },
        "width": { "type": "number" },
        "points": { "type": "json" },
        "seq": { "type": "number", "optional": true }
      }
    }
  },
  "hostComponents": ["canvas"],
  "surfaces": [{ "kind": "window", "fn": "window", "title": "Drawing", "icon": "draw" }]
}
