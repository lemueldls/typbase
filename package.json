{
  "name": "typbase",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "moon run web:build",
    "dev": "moon run web:dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "moon run web:generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "packages:build": "moon run typing:build storage:build spaces:build codemirror:build",
    "packages:dev": "moon run typing:build-dev storage:build-dev spaces:build-dev codemirror:build-dev",
    "postinstall": "nuxt prepare",
    "preview": "moon run web:preview",
    "symbols": "node scripts/symbols/transform.mjs",
    "typecheck": "nuxt typecheck && pnpm --filter @typbase/typing --filter @typbase/storage --filter @typbase/spaces --filter @typbase/codemirror typecheck",
    "wasm:build": "moon run wasm:build-dev",
    "wasm:build:release": "moon run wasm:build"
  },
  "dependencies": {
    "@atproto/lex-client": "0.0.0-spaces-alpha-20260818163953",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@huggingface/transformers": "^4.2.0",
    "@nuxtjs/i18n": "github:onmax/i18n#agent/nuxt5-nitro3-runtime",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@typbase/codemirror": "workspace:*",
    "@typbase/spaces": "workspace:*",
    "@typbase/storage": "workspace:*",
    "@typbase/typing": "workspace:*",
    "@typbase/wasm": "workspace:*",
    "@vueuse/nuxt": "14.4.0",
    "@vueuse/router": "^14.4.0",
    "h3": "2.0.1-rc.22",
    "lru-cache": "^11.2.5",
    "material-symbols": "0.40.2",
    "nuxt": "npm:nuxt-nightly@5.0.0-29803630.047484a6",
    "oxfmt": "^0.65.0",
    "reka-ui": "^2.10.4",
    "sqlite-wasm-vec": "^0.1.11",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@moonrepo/cli": "^2.3.4",
    "golar": "^0.1.10",
    "nitro": "3.0.260610-beta",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "packageManager": "pnpm@12.4.0"
}
