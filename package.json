{
  "name": "typbase",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "moon run web:build",
    "changelog": "git-cliff --unreleased --strip header",
    "dev": "moon run web:dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "moon run web:generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "packages:build": "moon run typing:build storage:build spaces:build codemirror:build",
    "packages:dev": "moon run typing:build-dev storage:build-dev spaces:build-dev codemirror:build-dev",
    "preview": "moon run web:preview",
    "symbols": "node scripts/symbols/transform.mjs",
    "test:e2e": "pnpm --filter @typbase/web test:e2e",
    "typecheck": "pnpm --filter @typbase/web typecheck && pnpm --filter @typbase/typing --filter @typbase/storage --filter @typbase/spaces --filter @typbase/codemirror typecheck"
  },
  "dependencies": {
    "@tauri-apps/api": "^3.0.0-alpha.0",
    "@tauri-apps/cli": "^3.0.0-alpha.1",
    "@tauri-apps/plugin-cli": "^3.0.0-alpha.0",
    "@tauri-apps/plugin-deep-link": "^3.0.0-alpha.0",
    "@tauri-apps/plugin-opener": "^3.0.0-alpha.0",
    "@tauri-apps/plugin-process": "^3.0.0-alpha.0",
    "@tauri-apps/plugin-updater": "^3.0.0-alpha.0"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@moonrepo/cli": "^2.3.4",
    "git-cliff": "^2.14.2",
    "golar": "^0.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0"
  },
  "packageManager": "pnpm@12.4.2"
}
