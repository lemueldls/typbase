{
  "name": "typbase",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "moon run web:build",
    "changelog": "git-cliff --unreleased --strip header",
    "dev": "moon run web:dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "moon run web:generate",
    "generate:direct": "bash scripts/build-web-direct.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "packages:build": "moon run engine:build typing:build storage:build spaces:build plugin-sdk:build skin:build cli:build codemirror:build",
    "packages:dev": "moon run typing:build-dev storage:build-dev spaces:build-dev plugin-sdk:build-dev skin:build-dev cli:build-dev codemirror:build-dev",
    "check:packages": "node scripts/ci/check-packages.mjs",
    "preview": "moon run web:preview",
    "symbols": "node scripts/symbols/transform.mjs",
    "test:e2e": "pnpm --filter @typbase/web test:e2e",
    "test:unit": "pnpm --filter @typbase/web test:unit",
    "typecheck": "pnpm --filter @typbase/web typecheck && pnpm --filter @typbase/proxy typecheck && pnpm --filter @typbase/registry typecheck && pnpm --filter @typbase/typing --filter @typbase/storage --filter @typbase/spaces --filter @typbase/plugin-sdk --filter @typbase/skin --filter @typbase/cli --filter @typbase/codemirror typecheck",
    "dev:proxy": "moon run proxy:dev",
    "build:proxy": "moon run proxy:build",
    "test:proxy": "pnpm --filter @typbase/proxy test",
    "dev:registry": "moon run registry:dev",
    "build:registry": "moon run registry:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^3.0.0-alpha.3",
    "@tauri-apps/cli": "^3.0.0-alpha.6",
    "@tauri-apps/plugin-cli": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-deep-link": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-opener": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-process": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-updater": "^3.0.0-alpha.3"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.11",
    "@moonrepo/cli": "^2.6.5",
    "git-cliff": "^2.14.2",
    "golar": "^0.1.11",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "^1.65.0",
    "takumi-js": "^2.20.0"
  },
  "packageManager": "pnpm@12.6.0"
}
